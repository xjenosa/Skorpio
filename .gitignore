# ── Secrets ───────────────────────────────────────────────────────────── #
# Match nested env files too (e.g. video/.env, frontend/.env). Without the
# **/ glob a nested .env can sneak into commits and leak API keys.
**/.env
**/.env.local
**/.env.*.local

# ── Python ────────────────────────────────────────────────────────────── #
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
*.egg-info/
.venv/
venv/

# ── Node / frontend ───────────────────────────────────────────────────── #
node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo

# ── Remotion video subproject ─────────────────────────────────────────── #
video/node_modules/
video/out/
video/.remotion/

# ── Runtime output (regenerated by the running app) ───────────────────── #
data/results/
data/plans/

# ── Caches / fetched reference data ───────────────────────────────────── #
# Currently ignored. App must be able to bootstrap (re-download or fall
# back) without these. Flip to commit if you want clone-and-run.
data/cache/
data/transmission/

# ── Build artifacts ───────────────────────────────────────────────────── #
build/
dist/

# ── IDE / editor ──────────────────────────────────────────────────────── #
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────────────── #
.DS_Store
Thumbs.db

# Office lockfiles (the ~$ files Word/PowerPoint create while a doc is open)
~$*

# ── Claude Code / memory / scratch ────────────────────────────────────── #
# Never commit. Local-only context the assistant maintains across sessions.
.claude/
CLAUDE.md
memory/

.vercel
