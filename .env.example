# ── Anthropic ─────────────────────────────────────────────────────────── #
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Database ──────────────────────────────────────────────────────────── #
DATABASE_URL=postgresql+asyncpg://skorpio:skorpio@localhost:5432/skorpio

# ── App ───────────────────────────────────────────────────────────────── #
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── EIA (U.S. Energy Information Administration) ──────────────────────── #
# https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# ── Grid carbon intensity ─────────────────────────────────────────────── #
# Computed locally from each province's published fuel mix and IPCC AR5
# Annex III lifecycle emission factors. No API key required. See
# backend/services/carbon_intensity.py.

# ── NREL Developer Network (Wind / Solar / Utility Rates) ─────────────── #
# https://developer.nrel.gov/signup/
NREL_API_KEY=

# ── OpenEI (Utility associations + tariffs) ───────────────────────────── #
# https://openei.org/services/
OPENEI_API_KEY=

# ── Weather: Open-Meteo (free, no key, 10k req/day) ──────────────────── #
# https://open-meteo.com — no sign-up required. Base URL is set in
# backend/config.py; you don't need to add anything here.

# ── NRCan Wildland Fire (live perimeters + Fire Weather Index, no key) ── #
# https://cwfis.cfs.nrcan.gc.ca — public GeoServer / WMS feeds.

# ── PeeringDB (internet exchange directory, no key for read) ──────────── #
# https://www.peeringdb.com — anonymous read works; register for higher
# rate limits if you start fanning out heavily.

# ── ECCC weather.gc.ca (hydrometric + climate normals, no key) ────────── #
# https://api.weather.gc.ca — public OGC API for hydrometric stations,
# climate normals, and other Environment and Climate Change Canada data.

# ── Climate Atlas of Canada (future projections, no key) ──────────────── #
# https://climateatlas.ca — RCP 4.5 / 8.5 projections through 2080.

# ── ArcGIS / Esri (GeoEnrichment, Demographics, Basemaps, Geocoding) ──── #
# OAuth 2.0 app-authentication credentials minted inside an ArcGIS Online
# org (e.g. senecatechnology.maps.arcgis.com → Content → New item →
# Developer credentials → OAuth 2.0 app authentication). The backend
# exchanges these at https://www.arcgis.com/sharing/rest/oauth2/token
# for a short-lived access token, then attaches it to GeoEnrichment /
# Geocoding REST calls. Required privileges on the credential: Basemaps,
# Geocoding, Data enrichment, Premium content. Leave both blank to skip
# the integration — the affected pipelines fall back to synthesized data.
ARCGIS_CLIENT_ID=
ARCGIS_CLIENT_SECRET=

# ── ISO bulletins ─────────────────────────────────────────────────────── #
PJM_API_KEY=
ERCOT_API_KEY=

# ── ElevenLabs (text-to-speech for the demo video narration) ──────────── #
# Lives in video/.env (the Remotion subproject), NOT here. The backend
# never reads it. See video/.env.example for setup.

# ── Optional: Snowflake Site Intelligence Layer ───────────────────────── #
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# ── Stage 2: Auth (Google OAuth + email magic-code via Resend) ────────── #
# Get these from https://console.cloud.google.com/ → APIs & Services →
# Credentials → your OAuth 2.0 Client ID. The redirect URI registered in
# the Google console must exactly match GOOGLE_OAUTH_REDIRECT_URI below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Resend — get a key at https://resend.com/api-keys.
# RESEND_FROM_EMAIL can stay on the shared `onboarding@resend.dev` sender
# until you've verified your own domain in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Random 32+ byte secret used to sign session JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SKORPIO_AUTH_SECRET=
# Session lifetime in hours. 168 = 7 days.
SKORPIO_AUTH_TOKEN_TTL_HOURS=168

# Comma-separated allowlist of emails permitted to sign in. Empty = no
# restriction (dev default — anyone with the URL can log in). Set this on
# deployed instances so unauthenticated visitors can't burn your Claude
# credits. Applies to BOTH email magic-code AND Google OAuth. Matches
# case-insensitively. Example:
#   SKORPIO_ALLOWED_EMAILS=alimximln@gmail.com,judge@seneca.ca
SKORPIO_ALLOWED_EMAILS=

# Where to redirect users back to after Google OAuth completes. Frontend
# dev server default is :3000; production should be the deployed URL.
FRONTEND_URL=http://localhost:3000

# ── Frontend (Vite) — picked up by the frontend dev container ─────────── #
# Base URL the SPA hits for API calls. Leave blank in production when
# frontend + backend are served from the same origin; the client falls
# back to a same-origin relative path. Set explicitly for local dev or
# when the SPA runs on a different host than the backend.
VITE_API_URL=http://localhost:8000

# Locks the deployed instance into demo mode (fixtures only, no
# backend writes). Vercel build sets this to "true" so the public deploy
# can't burn Claude credits even if someone reaches /login. Leave blank
# for local dev — the in-page toggle still works.
VITE_DEMO_ONLY=

# Optional Mapbox access token. When set, the report pages render an
# interactive map of sites / feeders / FSAs / assets. When blank, the map
# component falls back to a plain coords list so the UI still works.
# Get a free token at https://account.mapbox.com (50K loads/month free).
VITE_MAPBOX_TOKEN=
